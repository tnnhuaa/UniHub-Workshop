generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRoleType {
  student
  organizer
  checkin_staff
}

enum WorkshopStatus {
  draft
  published
  cancelled
  completed
}

enum RegistrationStatus {
  pending
  confirmed
  cancelled
  expired
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum CheckinSyncStatus {
  pending
  synced
  rejected
}

enum AssignmentStatus {
  active
  inactive
}

enum DocumentProcessingStatus {
  pending
  processing
  completed
  failed
}

enum JobStatus {
  pending
  running
  completed
  failed
}

enum NotificationChannel {
  email
  in_app
  telegram
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum NotificationType {
  custom
  workshop_registration_confirmed
}

model BetterAuthUser {
  id            String                 @id @default(cuid())
  name          String?
  email         String                 @unique
  emailVerified Boolean                @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  sessions      BetterAuthSession[]
  accounts      BetterAuthAccount[]
  roles         UserRole[]
  student       Student?
  workshops     Workshop[]             @relation("OrganizerWorkshops")
  checkins      Checkin[]              @relation("StaffCheckins")
  assignments   StaffWorkshopAssignment[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("better_auth_users")
}

model BetterAuthSession {
  id        String         @id @default(cuid())
  userId    String         @map("user_id")
  token     String         @unique
  expiresAt DateTime       @map("expires_at")
  ipAddress String?        @map("ip_address")
  userAgent String?        @map("user_agent")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user BetterAuthUser @relation(fields: [userId], references: [id])

  @@map("better_auth_sessions")
}

model BetterAuthAccount {
  id                    String         @id @default(cuid())
  userId                String         @map("user_id")
  accountId             String         @map("account_id")
  providerId            String         @map("provider_id")
  accessToken           String?        @map("access_token")
  refreshToken          String?        @map("refresh_token")
  accessTokenExpiresAt  DateTime?      @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime?      @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?        @map("id_token")
  password              String?
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  user BetterAuthUser @relation(fields: [userId], references: [id])

  @@map("better_auth_accounts")
}

model BetterAuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("better_auth_verifications")
}

model Jwks {
  id         String   @id @default(cuid())
  publicKey  String   @map("public_key")
  privateKey String   @map("private_key")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")

  @@map("jwks")
}

model UserRole {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  role      UserRoleType
  createdAt DateTime     @default(now()) @map("created_at")

  user BetterAuthUser @relation(fields: [userId], references: [id])

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model Student {
  mssv             String   @id
  email            String?
  fullName         String?  @map("full_name")
  phone            String?
  faculty          String?
  className        String?  @map("class_name")
  status           String?
  betterAuthUserId String?  @unique @map("better_auth_user_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  csvSyncedAt      DateTime? @map("csv_synced_at")

  user          BetterAuthUser? @relation(fields: [betterAuthUserId], references: [id])
  registrations Registration[]
  checkins      Checkin[]

  @@map("students")
}

model Workshop {
  id              String                 @id @default(uuid())
  title           String
  description     String?
  speaker         String?
  room            String?
  capacity        Int
  registeredCount Int                    @default(0) @map("registered_count")
  price           Decimal                @default(0) @db.Decimal(10, 2)
  startTime       DateTime               @map("start_time")
  endTime         DateTime               @map("end_time")
  status          WorkshopStatus         @default(draft)
  floorMapUrl     String?                @map("floor_map_url")
  organizerId     String?                @map("organizer_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  organizer   BetterAuthUser?           @relation("OrganizerWorkshops", fields: [organizerId], references: [id])
  registrations Registration[]
  checkins      Checkin[]
  assignments   StaffWorkshopAssignment[]
  documents     WorkshopDocument[]

  @@index([organizerId])
  @@map("workshops")
}

model Registration {
  id                 String             @id @default(uuid())
  mssv               String
  workshopId         String             @map("workshop_id")
  status             RegistrationStatus @default(pending)
  paymentStatus      PaymentStatus      @default(pending) @map("payment_status")
  qrCode             String?            @map("qr_code")
  registeredAt       DateTime           @default(now()) @map("registered_at")
  paymentCompletedAt DateTime?          @map("payment_completed_at")
  heldUntil          DateTime?          @map("held_until")
  cancellationReason String?            @map("cancellation_reason")
  createdAt          DateTime           @default(now()) @map("created_at")

  student     Student   @relation(fields: [mssv], references: [mssv])
  workshop    Workshop  @relation(fields: [workshopId], references: [id])
  payments    Payment[]
  checkins    Checkin[]

  @@unique([mssv, workshopId])
  @@index([mssv])
  @@index([workshopId])
  @@map("registrations")
}

model Payment {
  id             String        @id @default(uuid())
  registrationId String        @map("registration_id")
  provider       String
  providerRef    String?       @unique @map("provider_ref")
  idempotencyKey String        @unique @map("idempotency_key")
  amount         Decimal       @db.Decimal(10, 2)
  currency       String
  status         PaymentStatus @default(pending)
  requestedAt    DateTime      @default(now()) @map("requested_at")
  completedAt    DateTime?     @map("completed_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  registration Registration @relation(fields: [registrationId], references: [id])

  @@index([registrationId])
  @@map("payments")
}

model Checkin {
  id            String           @id @default(uuid())
  mssv          String
  workshopId    String           @map("workshop_id")
  checkinStaffId String?         @map("checkin_staff_id")
  registrationId String?         @map("registration_id")
  deviceEventId String?          @unique @map("device_event_id")
  checkedInAt   DateTime         @default(now()) @map("checked_in_at")
  syncedAt      DateTime?        @map("synced_at")
  syncStatus    CheckinSyncStatus @default(pending) @map("sync_status")
  createdAt     DateTime         @default(now()) @map("created_at")

  student      Student          @relation(fields: [mssv], references: [mssv])
  workshop     Workshop         @relation(fields: [workshopId], references: [id])
  checkinStaff BetterAuthUser?  @relation("StaffCheckins", fields: [checkinStaffId], references: [id])
  registration Registration?    @relation(fields: [registrationId], references: [id])

  @@unique([mssv, workshopId])
  @@index([mssv])
  @@index([workshopId])
  @@index([registrationId])
  @@map("checkins")
}

model StaffWorkshopAssignment {
  id          String           @id @default(uuid())
  staffUserId String           @map("staff_user_id")
  workshopId  String           @map("workshop_id")
  status      AssignmentStatus @default(active)
  assignedAt  DateTime         @default(now()) @map("assigned_at")

  staff    BetterAuthUser @relation(fields: [staffUserId], references: [id])
  workshop Workshop       @relation(fields: [workshopId], references: [id])

  @@unique([staffUserId, workshopId])
  @@index([staffUserId])
  @@index([workshopId])
  @@map("staff_workshop_assignments")
}

model WorkshopDocument {
  id               String                   @id @default(uuid())
  workshopId       String                   @map("workshop_id")
  fileUrl          String                   @map("file_url")
  fileName         String                   @map("file_name")
  processingStatus DocumentProcessingStatus @default(pending) @map("processing_status")
  uploadedAt       DateTime                 @default(now()) @map("uploaded_at")

  workshop Workshop        @relation(fields: [workshopId], references: [id])
  summaryJobs AiSummaryJob[]

  @@index([workshopId])
  @@map("workshop_documents")
}

model AiSummaryJob {
  id         String    @id @default(uuid())
  documentId String    @map("document_id")
  summaryText String?  @map("summary_text")
  status     JobStatus @default(pending)
  retryCount Int       @default(0) @map("retry_count")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  document WorkshopDocument @relation(fields: [documentId], references: [id])

  @@index([documentId])
  @@map("ai_summary_jobs")
}

model NotificationDelivery {
  id           String             @id @default(uuid())
  notificationId String           @map("notification_id")
  channel      NotificationChannel
  status       NotificationStatus @default(pending)
  providerRef  String?            @map("provider_ref")
  errorMessage String?            @map("error_message")
  dedupeKey    String?            @unique @map("dedupe_key")
  sentAt       DateTime?          @map("sent_at")
  createdAt    DateTime           @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id])

  @@index([notificationId])
  @@map("notification_deliveries")
}

model Notification {
  id         String             @id @default(uuid())
  userId     String             @map("user_id")
  type       NotificationType
  title      String
  body       String
  data       Json?
  eventKey   String?            @unique @map("event_key")
  readAt     DateTime?          @map("read_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  user       BetterAuthUser         @relation(fields: [userId], references: [id])
  deliveries NotificationDelivery[]

  @@index([userId])
  @@index([readAt])
  @@map("notifications")
}

model AuditLog {
  id           String    @id @default(uuid())
  actorUserId  String?   @map("actor_user_id")
  action       String
  resourceType String    @map("resource_type")
  resourceId   String    @map("resource_id")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")

  actor BetterAuthUser? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@map("audit_logs")
}

model CsvLog {
  id               String    @id @default(uuid())
  sourceFile       String    @map("source_file")
  totalRecords     Int       @map("total_records")
  successfulRecords Int      @map("successful_records")
  failedRecords    Int       @map("failed_records")
  conflictRecords  Int       @map("conflict_records")
  status           JobStatus @default(pending)
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  errors CsvLogError[]

  @@index([status])
  @@index([startedAt])
  @@map("csv_import_batches")
}

model CsvLogError {
  id        String   @id @default(uuid())
  batchId   String   @map("batch_id")
  rowNumber Int      @map("row_number")
  message   String
  rawRow    Json?    @map("raw_row")
  createdAt DateTime @default(now()) @map("created_at")

  batch CsvLog @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@map("csv_import_errors")
}
