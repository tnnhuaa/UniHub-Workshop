{
  "name": "unihub-workshop",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/parser": "^8.59.2",
    "@types/jest": "^30.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "prisma": "6.19.3"
  },
  "scripts": {
    "prepare": "husky",
    "format": "pnpm -r --parallel format",
    "build": "pnpm -r --parallel build",
    "dev": "pnpm -r --parallel dev",
    "db:init": "node data/init-db.js",
    "db:seed": "node data/seed.js",
    "lint": "pnpm -r --parallel lint",
    "lint:fix": "pnpm -C apps/api lint",
    "api:build": "pnpm -C apps/api build",
    "api:dev": "pnpm -C apps/api start:dev",
    "api:test": "pnpm -C apps/api test",
    "api:prisma:generate": "pnpm -C apps/api prisma:generate",
    "api:prisma:migrate": "pnpm -C apps/api prisma:migrate",
    "worker:start": "pnpm -C apps/api worker:start",
    "worker:build": "pnpm -C apps/api worker:build",
    "worker:start:prod": "pnpm -C apps/api worker:start:prod"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.6"
  }
}
