# === Application ===
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# === Database (PostgreSQL) ===
# Connect via connection pooler (e.g. PgBouncer)
DATABASE_URL="postgresql://user:password@localhost:6543/unihub?pgbouncer=true"
# Direct connection (used for migrations)
DIRECT_URL="postgresql://user:password@localhost:5432/unihub"

# === Redis ===
# REDIS_URL=redis://localhost:6379

# === RabbitMQ ===
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# === BetterAuth ===
# BETTER_AUTH_SECRET=your-secret-key

# === Object Storage (S3-compatible) ===
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=unihub-uploads

# === LLM (Google Gemini) ===
# GEMINI_API_KEY=your-gemini-api-key

# === Payment Gateway (Sandbox) ===
# PAYMENT_PROVIDER=mock
# PAYMENT_WEBHOOK_SECRET=your-webhook-secret
