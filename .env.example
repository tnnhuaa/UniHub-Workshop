# === Application ===
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*
VITE_API_BASE_URL=http://localhost:3000/api/v1

# === Database (PostgreSQL) ===
# Connect via connection pooler (e.g. PgBouncer)
DATABASE_URL="postgresql://user:password@localhost:6543/unihub?pgbouncer=true"
# Direct connection (used for migrations)
DIRECT_URL="postgresql://user:password@localhost:5432/unihub"

# === Redis ===
REDIS_URL=redis://localhost:6379

# === RabbitMQ ===
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# === BetterAuth ===
# BETTER_AUTH_SECRET=replace-with-32-char-secret
# BETTER_AUTH_URL=http://localhost:3000/api/v1/auth
# BETTER_AUTH_JWT_ISSUER=unihub-api
# BETTER_AUTH_JWT_AUDIENCE=unihub-mobile
# BETTER_AUTH_JWT_TTL=15m
# BETTER_AUTH_SESSION_TTL=30d
# GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback/google

# === Notifications (SMTP) ===
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM_NAME=UniHub Workshop
# SMTP_FROM_EMAIL=no-reply@unihub.local

# === Object Storage (S3-compatible) ===
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=unihub-uploads

# === LLM (Google Gemini) ===
# GEMINI_API_KEY=your-gemini-api-key

# === Payment Gateway (Sandbox) ===
# PAYMENT_PROVIDER=mock
# PAYMENT_WEBHOOK_SECRET=your-webhook-secret
